{
  "version": "marzi-premium-shell-v1",
  "colors": {
    "cream": "#FFF7E8",
    "surface": "#FFFDF8",
    "softGreen": "#E8F5E9",
    "marziGreen": "#2E7D32",
    "deepGreen": "#1B5E20",
    "accentGold": "#F5B84C",
    "coral": "#F28A65",
    "text": "#20211F",
    "muted": "#6E6F68",
    "border": "rgba(46,125,50,.14)"
  },
  "type": {
    "family": "Nunito Sans, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "display": {
      "size": 28,
      "lineHeight": 34,
      "weight": 800
    },
    "h1": {
      "size": 24,
      "lineHeight": 30,
      "weight": 800
    },
    "h2": {
      "size": 20,
      "lineHeight": 26,
      "weight": 800
    },
    "body": {
      "size": 16,
      "lineHeight": 22,
      "weight": 500
    },
    "small": {
      "size": 13,
      "lineHeight": 18,
      "weight": 600
    },
    "caption": {
      "size": 11,
      "lineHeight": 16,
      "weight": 700
    }
  },
  "spacing": {
    "base": 8,
    "scale": [
      8,
      12,
      16,
      24,
      32,
      48,
      64
    ]
  },
  "radius": {
    "small": 12,
    "medium": 18,
    "large": 24,
    "pill": 999
  },
  "shadow": {
    "card": "0 8px 24px rgba(57,51,39,.08)",
    "nav": "0 -8px 28px rgba(57,51,39,.08)"
  },
  "touchTargetMin": 48,
  "primaryViewport": {
    "width": 390,
    "height": 844
  },
  "supports": {
    "textScalePercent": 200,
    "rtl": true,
    "reducedMotion": true
  }
}