{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile Model V1",
  "type": "object",
  "required": [
    "displayName",
    "groups",
    "labels"
  ],
  "properties": {
    "displayName": {
      "type": "string"
    },
    "level": {
      "type": [
        "string",
        "null"
      ]
    },
    "xpCurrent": {
      "type": [
        "number",
        "null"
      ]
    },
    "xpNext": {
      "type": [
        "number",
        "null"
      ]
    },
    "groups": {
      "type": "array"
    },
    "labels": {
      "type": "object"
    }
  }
}