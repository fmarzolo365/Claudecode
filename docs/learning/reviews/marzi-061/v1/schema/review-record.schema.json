{
 "dialect": "marzi.schema-subset.v1",
 "$id": "marzi-061:schema:review-record",
 "title": "MARZI-061 review record",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schemaVersion",
  "packageId",
  "reviewId",
  "reviewType",
  "packageVersion",
  "reviewedArtifact",
  "preparationStatus",
  "externalGateStatus",
  "appointmentStatus",
  "executionStatus",
  "evidenceStatus",
  "findingsStatus",
  "completionStatus",
  "decisionStatus",
  "decision",
  "remediationStatus",
  "rereviewStatus",
  "reviewer",
  "reviewDate",
  "evidenceReferences",
  "findings",
  "conditions",
  "expirationOrRereviewTrigger",
  "supersedes",
  "auditHistory"
 ],
 "properties": {
  "schemaVersion": {
   "const": 1
  },
  "packageId": {
   "const": "MARZI-061"
  },
  "reviewId": {
   "type": "string",
   "pattern": "^marzi-review:marzi-061:(learning-pedagogy|linguistic|accessibility|android-study):v1$"
  },
  "reviewType": {
   "enum": [
    "learning_pedagogy",
    "linguistic",
    "accessibility",
    "android_study"
   ]
  },
  "packageVersion": {
   "const": "v1"
  },
  "reviewedArtifact": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "packageId",
    "contractVersion",
    "implementationCommit",
    "paths",
    "contentHashes"
   ],
   "properties": {
    "packageId": {
     "const": "MARZI-021"
    },
    "contractVersion": {
     "const": 1
    },
    "implementationCommit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    },
    "paths": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
     }
    },
    "contentHashes": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "path",
       "sha256"
      ],
      "properties": {
       "path": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       }
      }
     }
    }
   }
  },
  "preparationStatus": {
   "enum": [
    "NOT_PREPARED",
    "PREPARED"
   ]
  },
  "externalGateStatus": {
   "enum": [
    "PENDING",
    "DECIDED"
   ]
  },
  "appointmentStatus": {
   "enum": [
    "NOT_APPOINTED",
    "APPOINTED"
   ]
  },
  "executionStatus": {
   "enum": [
    "NOT_STARTED",
    "IN_PROGRESS",
    "COMPLETED"
   ]
  },
  "evidenceStatus": {
   "enum": [
    "NOT_COLLECTED",
    "PARTIAL",
    "COMPLETE"
   ]
  },
  "findingsStatus": {
   "enum": [
    "NOT_RECORDED",
    "RECORDED"
   ]
  },
  "completionStatus": {
   "enum": [
    "NOT_COMPLETED",
    "COMPLETED"
   ]
  },
  "decisionStatus": {
   "enum": [
    "NOT_GRANTED",
    "GRANTED"
   ]
  },
  "decision": {
   "enum": [
    "NOT_REVIEWED",
    "APPROVED",
    "APPROVED_WITH_CONDITIONS",
    "CHANGES_REQUIRED",
    "BLOCKED"
   ]
  },
  "remediationStatus": {
   "enum": [
    "NOT_DETERMINED",
    "NOT_REQUIRED",
    "REQUIRED",
    "IN_PROGRESS",
    "COMPLETE"
   ]
  },
  "rereviewStatus": {
   "enum": [
    "NOT_DETERMINED",
    "NOT_REQUIRED",
    "REQUIRED",
    "COMPLETE"
   ]
  },
  "reviewer": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "required": [
    "reviewerId",
    "displayName",
    "role",
    "qualificationDescription",
    "organization",
    "conflictOfInterestDeclaration",
    "identityVerificationState"
   ],
   "properties": {
    "reviewerId": {
     "type": "string",
     "pattern": "^marzi-reviewer:[a-z0-9][a-z0-9-]*$"
    },
    "displayName": {
     "type": "string",
     "minLength": 1
    },
    "role": {
     "type": "string",
     "minLength": 1
    },
    "qualificationDescription": {
     "type": "string",
     "minLength": 1
    },
    "organization": {
     "type": [
      "string",
      "null"
     ]
    },
    "conflictOfInterestDeclaration": {
     "type": "string",
     "minLength": 1
    },
    "identityVerificationState": {
     "const": "NOT_VERIFIED_EXTERNALLY"
    }
   }
  },
  "reviewDate": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$"
  },
  "evidenceReferences": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^marzi-evidence:marzi-061:(learning-pedagogy|linguistic|accessibility|android-study):[0-9]{3}$"
   }
  },
  "findings": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "findingId",
     "reviewId",
     "severity",
     "category",
     "artifactPath",
     "location",
     "evidence",
     "impact",
     "recommendation",
     "disposition",
     "evidenceReferences",
     "ownerRole",
     "rereviewRequired"
    ],
    "properties": {
     "findingId": {
      "type": "string",
      "pattern": "^marzi-finding:marzi-061:(learning-pedagogy|linguistic|accessibility|android-study):[0-9]{3}$"
     },
     "reviewId": {
      "type": "string",
      "pattern": "^marzi-review:marzi-061:(learning-pedagogy|linguistic|accessibility|android-study):v1$"
     },
     "severity": {
      "enum": [
       "BLOCKER",
       "HIGH",
       "MEDIUM",
       "LOW",
       "INFORMATIONAL"
      ]
     },
     "category": {
      "type": "string",
      "minLength": 2
     },
     "artifactPath": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
     },
     "location": {
      "type": "string",
      "minLength": 1
     },
     "evidence": {
      "type": "string",
      "minLength": 1
     },
     "impact": {
      "type": "string",
      "minLength": 1
     },
     "recommendation": {
      "type": "string",
      "minLength": 1
     },
     "disposition": {
      "enum": [
       "OPEN",
       "ACCEPTED",
       "REMEDIATION_PLANNED",
       "RESOLVED",
       "DEFERRED",
       "REJECTED_WITH_RATIONALE"
      ]
     },
     "evidenceReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
       "type": "string",
       "pattern": "^marzi-evidence:marzi-061:(learning-pedagogy|linguistic|accessibility|android-study):[0-9]{3}$"
      }
     },
     "ownerRole": {
      "type": "string",
      "minLength": 1
     },
     "rereviewRequired": {
      "type": "boolean"
     }
    }
   }
  },
  "conditions": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 5
   }
  },
  "expirationOrRereviewTrigger": {
   "type": [
    "string",
    "null"
   ]
  },
  "supersedes": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^marzi-review:marzi-061:(learning-pedagogy|linguistic|accessibility|android-study):v[0-9]+$"
  },
  "blockingRationale": {
   "type": [
    "string",
    "null"
   ]
  },
  "zeroFindingsAttestation": {
   "type": [
    "boolean",
    "null"
   ]
  },
  "auditHistory": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "eventId",
     "event",
     "timestamp",
     "actorRole",
     "priorState",
     "nextState",
     "note"
    ],
    "properties": {
     "eventId": {
      "type": "string",
      "pattern": "^marzi-audit:marzi-061:[a-z-]+:[0-9]{3}$"
     },
     "event": {
      "enum": [
       "PACKAGE_PREPARED",
       "REVIEWER_APPOINTED",
       "REVIEW_STARTED",
       "EVIDENCE_RECORDED",
       "FINDINGS_RECORDED",
       "REVIEW_COMPLETED",
       "DECISION_RECORDED",
       "SUPERSEDED"
      ]
     },
     "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
     },
     "actorRole": {
      "type": "string",
      "minLength": 1
     },
     "priorState": {
      "type": "string",
      "minLength": 1
     },
     "nextState": {
      "type": "string",
      "minLength": 1
     },
     "note": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
