{
 "dialect": "marzi.schema-subset.v1",
 "$id": "marzi-061:schema:package-manifest",
 "title": "MARZI-061 package manifest",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "contract",
  "schemaVersion",
  "packageId",
  "packageVersion",
  "packageTitle",
  "preparedFor",
  "reviewedCommit",
  "productOwnerAllocation",
  "allocationApprovalDate",
  "tracks",
  "artifacts",
  "locales",
  "acceptedInventories",
  "knownIssues",
  "boundaries"
 ],
 "properties": {
  "contract": {
   "const": "marzi.review.package-manifest.v1"
  },
  "schemaVersion": {
   "const": 1
  },
  "packageId": {
   "const": "MARZI-061"
  },
  "packageVersion": {
   "const": "v1"
  },
  "packageTitle": {
   "const": "External Review Readiness Package"
  },
  "preparedFor": {
   "const": "MARZI-021"
  },
  "reviewedCommit": {
   "type": "string",
   "pattern": "^[0-9a-f]{40}$"
  },
  "productOwnerAllocation": {
   "type": "string",
   "minLength": 40
  },
  "allocationApprovalDate": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
  },
  "tracks": {
   "type": "array",
   "minItems": 4,
   "maxItems": 4,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "reviewId",
     "reviewType"
    ],
    "properties": {
     "reviewId": {
      "type": "string",
      "pattern": "^marzi-review:marzi-061:(learning-pedagogy|linguistic|accessibility|android-study):v1$"
     },
     "reviewType": {
      "enum": [
       "learning_pedagogy",
       "linguistic",
       "accessibility",
       "android_study"
      ]
     }
    }
   }
  },
  "artifacts": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "path",
     "artifactType",
     "sha256"
    ],
    "properties": {
     "path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
     },
     "artifactType": {
      "enum": [
       "learning_contract",
       "learning_schema"
      ]
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    }
   }
  },
  "locales": {
   "type": "array",
   "minItems": 6,
   "maxItems": 6,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "locale",
     "languageName",
     "direction"
    ],
    "properties": {
     "locale": {
      "enum": [
       "ar",
       "en",
       "es",
       "it",
       "tr",
       "uk"
      ]
     },
     "languageName": {
      "type": "string",
      "minLength": 3
     },
     "direction": {
      "enum": [
       "ltr",
       "rtl"
      ]
     }
    }
   }
  },
  "acceptedInventories": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "scenarios",
    "variants",
    "germanScenarios",
    "germanVariants",
    "englishScenarios",
    "englishVariants",
    "localizedTitles",
    "requiredCriteria",
    "optionalCriteria",
    "prerequisiteEdges",
    "nullSupersessions",
    "openEducationalGates"
   ],
   "properties": {
    "scenarios": {
     "const": 29
    },
    "variants": {
     "const": 94
    },
    "germanScenarios": {
     "const": 19
    },
    "germanVariants": {
     "const": 61
    },
    "englishScenarios": {
     "const": 10
    },
    "englishVariants": {
     "const": 33
    },
    "localizedTitles": {
     "const": 564
    },
    "requiredCriteria": {
     "const": 282
    },
    "optionalCriteria": {
     "const": 94
    },
    "prerequisiteEdges": {
     "const": 18
    },
    "nullSupersessions": {
     "const": 94
    },
    "openEducationalGates": {
     "const": 4
    }
   }
  },
  "knownIssues": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "issueId",
     "summary",
     "category",
     "status",
     "fixedByThisPackage",
     "complianceClaim"
    ],
    "properties": {
     "issueId": {
      "type": "string",
      "pattern": "^MARZI-A11Y-KNOWN-[0-9]{3}$"
     },
     "summary": {
      "type": "string",
      "minLength": 10
     },
     "category": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "status": {
      "enum": [
       "OPEN",
       "RESOLVED"
      ]
     },
     "fixedByThisPackage": {
      "const": false
     },
     "complianceClaim": {
      "const": false
     }
    }
   }
  },
  "boundaries": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "minLength": 10
   }
  }
 }
}
