{
 "dialect": "marzi.schema-subset.v1",
 "$id": "marzi-061:schema:learning-review",
 "title": "MARZI-061 learning and pedagogy review record",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "contract",
  "schemaVersion",
  "packageId",
  "packageVersion",
  "derivedFrom",
  "derivationStatement",
  "entryCount",
  "entries"
 ],
 "properties": {
  "contract": {
   "const": "marzi.review.learning-matrix.v1"
  },
  "schemaVersion": {
   "const": 1
  },
  "packageId": {
   "const": "MARZI-061"
  },
  "packageVersion": {
   "const": "v1"
  },
  "derivedFrom": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
   }
  },
  "derivationStatement": {
   "type": "string",
   "minLength": 20
  },
  "entryCount": {
   "type": "integer",
   "minimum": 1
  },
  "entries": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "entryId",
     "scenarioId",
     "variantId",
     "scenarioObjectiveId",
     "targetLanguage",
     "sourceGoalIndex",
     "learnerLevel",
     "competencyIds",
     "requiredCriterionIds",
     "optionalCriterionIds",
     "allowedEvidenceTypes",
     "prerequisiteReferences",
     "supersedes",
     "completionContractReference",
     "reviewStatus",
     "findingReferences",
     "evidenceReferences"
    ],
    "properties": {
     "entryId": {
      "type": "string",
      "pattern": "^marzi-061:learning:(de|en)\\.[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+$"
     },
     "scenarioId": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "variantId": {
      "type": "string",
      "pattern": "^(de|en)\\.[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+$"
     },
     "scenarioObjectiveId": {
      "type": "string",
      "pattern": "^(de|en)\\.[a-z0-9_]+\\.[a-z0-9_]+$"
     },
     "targetLanguage": {
      "enum": [
       "de",
       "en"
      ]
     },
     "sourceGoalIndex": {
      "type": "integer",
      "minimum": 0
     },
     "learnerLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "min",
       "max"
      ],
      "properties": {
       "min": {
        "enum": [
         "A0",
         "A1",
         "A2",
         "B1",
         "B2",
         "C1"
        ]
       },
       "max": {
        "enum": [
         "A0",
         "A1",
         "A2",
         "B1",
         "B2",
         "C1"
        ]
       }
      }
     },
     "competencyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
       "type": "string",
       "pattern": "^(COM|INT|FUN|SOC|LNG|STR)\\.[A-Z][A-Z_]*$"
      }
     },
     "requiredCriterionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9_]+$"
      }
     },
     "optionalCriterionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9_]+$"
      }
     },
     "allowedEvidenceTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
       "enum": [
        "transcript_text",
        "typed_response",
        "interaction_event"
       ]
      }
     },
     "prerequisiteReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
       "type": "string",
       "minLength": 5
      }
     },
     "supersedes": {
      "type": "null"
     },
     "completionContractReference": {
      "type": "string",
      "minLength": 10
     },
     "reviewStatus": {
      "enum": [
       "NOT_REVIEWED",
       "REVIEWED"
      ]
     },
     "findingReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
       "type": "string",
       "pattern": "^marzi-finding:marzi-061:(learning-pedagogy|linguistic|accessibility|android-study):[0-9]{3}$"
      }
     },
     "evidenceReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
       "type": "string",
       "pattern": "^marzi-evidence:marzi-061:(learning-pedagogy|linguistic|accessibility|android-study):[0-9]{3}$"
      }
     }
    }
   }
  }
 }
}
