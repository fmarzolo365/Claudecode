{
 "dialect": "marzi.schema-subset.v1",
 "$id": "marzi-061:schema:decision",
 "title": "MARZI-061 review decision",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schemaVersion",
  "packageId",
  "reviewId",
  "decision",
  "decidingReviewer",
  "completedReviewReference",
  "grantDate",
  "evidenceReferences",
  "conditions",
  "rationale",
  "rereviewTrigger",
  "supersedes"
 ],
 "properties": {
  "schemaVersion": {
   "const": 1
  },
  "packageId": {
   "const": "MARZI-061"
  },
  "reviewId": {
   "type": "string",
   "pattern": "^marzi-review:marzi-061:(learning-pedagogy|linguistic|accessibility|android-study):v1$"
  },
  "decision": {
   "enum": [
    "NOT_REVIEWED",
    "APPROVED",
    "APPROVED_WITH_CONDITIONS",
    "CHANGES_REQUIRED",
    "BLOCKED"
   ]
  },
  "decidingReviewer": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "required": [
    "reviewerId",
    "displayName",
    "role",
    "qualificationDescription",
    "organization",
    "conflictOfInterestDeclaration",
    "identityVerificationState"
   ],
   "properties": {
    "reviewerId": {
     "type": "string",
     "pattern": "^marzi-reviewer:[a-z0-9][a-z0-9-]*$"
    },
    "displayName": {
     "type": "string",
     "minLength": 1
    },
    "role": {
     "type": "string",
     "minLength": 1
    },
    "qualificationDescription": {
     "type": "string",
     "minLength": 1
    },
    "organization": {
     "type": [
      "string",
      "null"
     ]
    },
    "conflictOfInterestDeclaration": {
     "type": "string",
     "minLength": 1
    },
    "identityVerificationState": {
     "const": "NOT_VERIFIED_EXTERNALLY"
    }
   }
  },
  "completedReviewReference": {
   "type": [
    "string",
    "null"
   ]
  },
  "grantDate": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$"
  },
  "evidenceReferences": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^marzi-evidence:marzi-061:(learning-pedagogy|linguistic|accessibility|android-study):[0-9]{3}$"
   }
  },
  "conditions": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 5
   }
  },
  "rationale": {
   "type": [
    "string",
    "null"
   ]
  },
  "rereviewTrigger": {
   "type": [
    "string",
    "null"
   ]
  },
  "supersedes": {
   "type": [
    "string",
    "null"
   ]
  }
 }
}
