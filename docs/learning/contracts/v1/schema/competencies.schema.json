{
 "dialect": "marzi.schema-subset.v1",
 "title": "Marzi competency taxonomy",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "contract",
  "schemaVersion",
  "curriculumVersion",
  "reviewStatus",
  "sourceDocument",
  "learnerFacingLabels",
  "families",
  "competencies"
 ],
 "properties": {
  "contract": {
   "const": "marzi.learning.competencies.v1"
  },
  "schemaVersion": {
   "const": 1
  },
  "curriculumVersion": {
   "type": "string",
   "pattern": "^v[0-9]+(-draft)?$"
  },
  "reviewStatus": {
   "enum": [
    "pending_specialist_review",
    "specialist_reviewed"
   ]
  },
  "sourceDocument": {
   "type": "string",
   "minLength": 5
  },
  "learnerFacingLabels": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "status",
    "gate"
   ],
   "properties": {
    "status": {
     "const": "OPEN_GATE"
    },
    "gate": {
     "type": "string",
     "pattern": "^MARZI-[A-Z0-9-]+$"
    },
    "note": {
     "type": "string",
     "minLength": 10
    },
    "blockedBy": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 3
     }
    }
   }
  },
  "families": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "scope"
    ],
    "properties": {
     "id": {
      "enum": [
       "COM",
       "INT",
       "FUN",
       "SOC",
       "LNG",
       "STR"
      ]
     },
     "name": {
      "type": "string",
      "minLength": 3
     },
     "scope": {
      "type": "string",
      "minLength": 10
     }
    }
   }
  },
  "competencies": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "family",
     "observableCapability",
     "reviewStatus"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^(COM|INT|FUN|SOC|LNG|STR)\\.[A-Z][A-Z_]*$"
     },
     "family": {
      "enum": [
       "COM",
       "INT",
       "FUN",
       "SOC",
       "LNG",
       "STR"
      ]
     },
     "observableCapability": {
      "type": "string",
      "minLength": 20
     },
     "reviewStatus": {
      "enum": [
       "pending_specialist_review",
       "specialist_reviewed"
      ]
     }
    }
   }
  }
 }
}
