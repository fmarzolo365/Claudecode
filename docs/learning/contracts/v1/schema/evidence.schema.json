{
 "dialect": "marzi.schema-subset.v1",
 "title": "Marzi learning evidence vocabulary",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "contract",
  "schemaVersion",
  "curriculumVersion",
  "reviewStatus",
  "opportunity",
  "observationOutcomes",
  "allowedEvidenceTypes",
  "rejectedEvidenceTypes",
  "assistance",
  "accessibilityAccommodation",
  "validityRules"
 ],
 "properties": {
  "contract": {
   "const": "marzi.learning.evidence.v1"
  },
  "schemaVersion": {
   "const": 1
  },
  "curriculumVersion": {
   "type": "string",
   "pattern": "^v[0-9]+(-draft)?$"
  },
  "reviewStatus": {
   "enum": [
    "pending_specialist_review",
    "specialist_reviewed"
   ]
  },
  "opportunity": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "description",
    "requiredFields",
    "invalidatingConditions",
    "rule"
   ],
   "properties": {
    "description": {
     "type": "string",
     "minLength": 20
    },
    "requiredFields": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
     }
    },
    "invalidatingConditions": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     }
    },
    "rule": {
     "type": "string",
     "minLength": 20
    }
   }
  },
  "observationOutcomes": {
   "type": "array",
   "minItems": 6,
   "maxItems": 6,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "meaning"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "meaning": {
      "type": "string",
      "minLength": 20
     }
    }
   }
  },
  "allowedEvidenceTypes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "meaning"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "meaning": {
      "type": "string",
      "minLength": 10
     }
    }
   }
  },
  "rejectedEvidenceTypes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "reasonCode"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
     }
    }
   }
  },
  "assistance": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "description",
    "modes",
    "fields",
    "derivationRelations",
    "rules"
   ],
   "properties": {
    "description": {
     "type": "string",
     "minLength": 20
    },
    "modes": {
     "type": "array",
     "minItems": 3,
     "maxItems": 3,
     "uniqueItems": true,
     "items": {
      "enum": [
       "OFF",
       "HINT",
       "FULL"
      ]
     }
    },
    "fields": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
     }
    },
    "derivationRelations": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     }
    },
    "rules": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 20
     }
    }
   }
  },
  "accessibilityAccommodation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "description",
    "fields",
    "accommodations",
    "rules",
    "separationRule"
   ],
   "properties": {
    "description": {
     "type": "string",
     "minLength": 20
    },
    "fields": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
     }
    },
    "accommodations": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     }
    },
    "rules": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 20
     }
    },
    "separationRule": {
     "type": "string",
     "minLength": 20
    }
   }
  },
  "validityRules": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "reasonCode",
     "rule"
    ],
    "properties": {
     "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
     },
     "rule": {
      "type": "string",
      "minLength": 20
     }
    }
   }
  }
 }
}
