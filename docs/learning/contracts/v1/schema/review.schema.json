{
 "dialect": "marzi.schema-subset.v1",
 "title": "Marzi review-candidate contract",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "contract",
  "schemaVersion",
  "curriculumVersion",
  "reviewStatus",
  "candidateRules",
  "prioritization",
  "neverCreatesNegativeObservation",
  "neverRemoves",
  "recencyPolicy"
 ],
 "properties": {
  "contract": {
   "const": "marzi.learning.review.v1"
  },
  "schemaVersion": {
   "const": 1
  },
  "curriculumVersion": {
   "type": "string",
   "pattern": "^v[0-9]+(-draft)?$"
  },
  "reviewStatus": {
   "enum": [
    "pending_specialist_review",
    "specialist_reviewed"
   ]
  },
  "candidateRules": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "trigger"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "trigger": {
      "type": "string",
      "minLength": 20
     }
    }
   }
  },
  "prioritization": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "explainable",
    "preferTransferContext",
    "rule"
   ],
   "properties": {
    "explainable": {
     "const": true
    },
    "preferTransferContext": {
     "const": true
    },
    "rule": {
     "type": "string",
     "minLength": 20
    }
   }
  },
  "neverCreatesNegativeObservation": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9_]+$"
   }
  },
  "neverRemoves": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^[a-z0-9_]+$"
   }
  },
  "recencyPolicy": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "status",
    "gate"
   ],
   "properties": {
    "status": {
     "const": "OPEN_GATE"
    },
    "gate": {
     "type": "string",
     "pattern": "^MARZI-[A-Z0-9-]+$"
    },
    "note": {
     "type": "string",
     "minLength": 10
    },
    "blockedBy": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 3
     }
    },
    "windowDays": {
     "type": [
      "integer",
      "null"
     ]
    }
   }
  }
 }
}
