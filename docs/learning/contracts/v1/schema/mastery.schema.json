{
 "dialect": "marzi.schema-subset.v1",
 "title": "Marzi mastery and confidence contract",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "contract",
  "schemaVersion",
  "curriculumVersion",
  "reviewStatus",
  "independenceRule",
  "forbiddenInputs",
  "states",
  "defaultState",
  "confidenceDimensions",
  "thresholds",
  "boundaryFixtures",
  "learnerFacingCopy"
 ],
 "properties": {
  "contract": {
   "const": "marzi.learning.mastery.v1"
  },
  "schemaVersion": {
   "const": 1
  },
  "curriculumVersion": {
   "type": "string",
   "pattern": "^v[0-9]+(-draft)?$"
  },
  "reviewStatus": {
   "enum": [
    "pending_specialist_review",
    "specialist_reviewed"
   ]
  },
  "independenceRule": {
   "type": "string",
   "minLength": 40
  },
  "forbiddenInputs": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
   }
  },
  "states": {
   "type": "array",
   "minItems": 5,
   "maxItems": 5,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "meaning"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "meaning": {
      "type": "string",
      "minLength": 20
     }
    }
   }
  },
  "defaultState": {
   "const": "not_enough_evidence"
  },
  "confidenceDimensions": {
   "type": "array",
   "minItems": 5,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "meaning"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "meaning": {
      "type": "string",
      "minLength": 10
     }
    }
   }
  },
  "thresholds": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "status",
    "gate"
   ],
   "properties": {
    "status": {
     "const": "OPEN_GATE"
    },
    "gate": {
     "type": "string",
     "pattern": "^MARZI-[A-Z0-9-]+$"
    },
    "note": {
     "type": "string",
     "minLength": 10
    },
    "blockedBy": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 3
     }
    },
    "minimumDistinctOpportunities": {
     "type": [
      "integer",
      "null"
     ]
    },
    "minimumDistinctContexts": {
     "type": [
      "integer",
      "null"
     ]
    },
    "recencyWindowDays": {
     "type": [
      "integer",
      "null"
     ]
    },
    "aggregationWeights": {
     "type": [
      "object",
      "null"
     ]
    }
   }
  },
