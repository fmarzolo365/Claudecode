#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const path = require("node:path");
const {
  EXIT,
  ToolError,
  assertSafeArgument,
  emitJson,
  git,
  guardMain,
  isInside,
  resolveRepoRoot
} = require("./lib.cjs");

const TOOL = "docs-validate";
const REQUIRED_MARKDOWN = [
  ".ai/EXECUTION_POLICY.md",
  "AGENTS.md",
  "docs/MARZI_DECISION_REGISTER.md",
  "docs/MARZI_MASTER_ROADMAP.md",
  "docs/MARZI_PACKAGE_TEMPLATE.md",
  "docs/MARZI_PRODUCT_BIBLE.md",
  "docs/MARZI_PROGRAM_GOVERNANCE.md",
  "docs/packages/MARZI-020.md"
];
const WRAPPERS = [
  ".ai/bin/repo-inspect",
  ".ai/bin/commit-inspect",
  ".ai/bin/docs-validate",
  ".ai/bin/file-inspect",
  ".ai/bin/browser-inspect"
];

function help() {
  process.stdout.write("Usage: .ai/bin/docs-validate [--json]\n");
}

function parseArgs(argv) {
  for (const argument of argv) assertSafeArgument(argument);
  if (argv.length === 1 && argv[0] === "--help") return { help: true };
  if (argv.length === 0) return { help: false };
  if (argv.length === 1 && argv[0] === "--json") return { help: false };
  throw new ToolError("unsupported option", EXIT.USAGE);
}

function numberedSections(source) {
  return Array.from(source.matchAll(/^## ([0-9]+)[.] /gm), (match) => Number(match[1]));
}

function expectedSequence(first, last) {
  return Array.from({ length: last - first + 1 }, (_, index) => first + index);
}

function sameSequence(actual, expected) {
  return actual.length === expected.length &&
    actual.every((value, index) => value === expected[index]);
}

function countFence(source, fence) {
  return source.split(fence).length - 1;
}

function internalLinks(root, relativeFile, source) {
  const failures = [];
  const pattern = /!?\[[^\]]*]\(([^)]+)\)/g;
  for (const match of source.matchAll(pattern)) {
    let target = match[1].trim();
    if (!target || target.startsWith("#")) continue;
    if (/^(?:https?:|mailto:|data:)/i.test(target)) continue;
    if (target.startsWith("<") && target.includes(">")) {
      target = target.slice(1, target.indexOf(">"));
    } else {
      target = target.split(/\s+/)[0];
    }
    target = target.split("#")[0].split("?")[0];
    if (!target) continue;
    let decoded;
    try {
      decoded = decodeURIComponent(target);
    } catch {
      failures.push(relativeFile + ": invalid encoded link " + target);
      continue;
    }
    const absolute = path.resolve(root, path.dirname(relativeFile), decoded);
    if (!isInside(root, absolute)) {
      failures.push(relativeFile + ": link escapes repository: " + target);
    } else if (!fs.existsSync(absolute)) {
      failures.push(relativeFile + ": broken internal link: " + target);
    } else {
      const real = fs.realpathSync(absolute);
      if (!isInside(root, real)) {
        failures.push(relativeFile + ": internal link resolves outside repository: " + target);
      }
    }
  }
  return failures;
}

function resolveRepositoryFile(root, relative) {
  const absolute = path.resolve(root, relative);
  if (!isInside(root, absolute)) {
    throw new ToolError("path escapes repository: " + relative, EXIT.VALIDATION);
  }
  let info;
  try {
    info = fs.lstatSync(absolute);
  } catch {
    throw new ToolError("missing file: " + relative, EXIT.VALIDATION);
  }
  if (info.isSymbolicLink()) {
    throw new ToolError("symbolic links are not accepted: " + relative, EXIT.VALIDATION);
  }
  const real = fs.realpathSync(absolute);
  if (!isInside(root, real) || !fs.statSync(real).isFile()) {
    throw new ToolError("path is not a contained regular file: " + relative, EXIT.VALIDATION);
  }
  return real;
}

guardMain(TOOL, () => {
  const options = parseArgs(process.argv.slice(2));
  if (options.help) {
    help();
    return;
  }

  const root = resolveRepoRoot();
  const checks = [];
  const failures = [];
  const warnings = [];
  const sources = new Map();

  function check(id, action) {
    const before = failures.length;
    let details = null;
    try {
      details = action();
    } catch (error) {
      failures.push(id + ": " + (error && error.message ? error.message : String(error)));
    }
    checks.push({
      id,
      status: failures.length === before ? "PASS" : "FAIL",
      details
    });
  }

  check("required-markdown", () => {
    for (const relative of REQUIRED_MARKDOWN) {
      try {
        const absolute = resolveRepositoryFile(root, relative);
        if (fs.statSync(absolute).size === 0) failures.push("required file is empty: " + relative);
        else sources.set(relative, fs.readFileSync(absolute, "utf8"));
      } catch (error) {
        failures.push(error.message);
      }
    }
    return { expected: REQUIRED_MARKDOWN.length, loaded: sources.size };
  });

  const roadmap = sources.get("docs/MARZI_MASTER_ROADMAP.md") || "";
  const bible = sources.get("docs/MARZI_PRODUCT_BIBLE.md") || "";
  const register = sources.get("docs/MARZI_DECISION_REGISTER.md") || "";
  const template = sources.get("docs/MARZI_PACKAGE_TEMPLATE.md") || "";
  const package020 = sources.get("docs/packages/MARZI-020.md") || "";
  const governance = sources.get("docs/MARZI_PROGRAM_GOVERNANCE.md") || "";
  const policy = sources.get(".ai/EXECUTION_POLICY.md") || "";
  const agents = sources.get("AGENTS.md") || "";

  const packageMatches = Array.from(
    roadmap.matchAll(/^## MARZI-([0-9]{3}) — (.+)$/gm)
  );
  const packageIds = packageMatches.map((match) => Number(match[1]));

  check("roadmap-package-numbering", () => {
    const expected = expectedSequence(20, 60);
    if (!sameSequence(packageIds, expected)) {
      failures.push("roadmap package headings must be exactly MARZI-020 through MARZI-060");
    }
    if (new Set(packageIds).size !== packageIds.length) {
      failures.push("duplicate roadmap package ID");
    }
    return { packageCount: packageIds.length, unique: new Set(packageIds).size };
  });

  check("roadmap-package-contracts", () => {
    const fields = [
      "Objective",
      "Problem solved",
      "Why it exists",
      "Prerequisites",
      "Dependencies",
      "Packages unblocked",
      "Exact deliverables",
      "Expected files/areas",
      "Measurable acceptance criteria",
      "Required automated tests",
      "Required real-device tests",
      "Product-owner approval gate",
      "Asset dependency",
      "Economic-system dependency",
      "Security/privacy impact",
      "Accessibility/localization impact",
      "Implementation risk",
      "Rollback strategy",
      "Estimated engineering effort",
      "Can run in parallel",
      "Completion evidence required"
    ];
    packageMatches.forEach((match, index) => {
      const start = match.index;
      const end = index + 1 < packageMatches.length
        ? packageMatches[index + 1].index
        : roadmap.indexOf("# Dependency graph", start);
      const section = roadmap.slice(start, end < 0 ? roadmap.length : end);
      for (const field of fields) {
        if (!section.includes("**" + field + ":**")) {
          failures.push("MARZI-" + match[1] + " missing field: " + field);
        }
      }
    });
    return { fieldsPerPackage: fields.length };
  });

  check("dependency-graph-coverage", () => {
    const graphStart = roadmap.indexOf("# Dependency graph");
    const graphEnd = roadmap.indexOf("# Critical path", graphStart);
    if (graphStart < 0 || graphEnd < 0) {
      failures.push("dependency graph or critical path section missing");
      return { covered: 0, expected: 34 };
    }
    const graph = roadmap.slice(graphStart, graphEnd);
    const expected = expectedSequence(20, 53)
      .map((number) => "MARZI-" + String(number).padStart(3, "0"));
    const missing = expected.filter((id) => !graph.includes(id));
    if (missing.length) failures.push("dependency graph missing: " + missing.join(", "));
    return { covered: expected.length - missing.length, expected: expected.length };
  });

  check("package-template-compliance", () => {
    const expected = expectedSequence(1, 31);
    const templateSections = numberedSections(template);
    const packageSections = numberedSections(package020);
    if (!sameSequence(templateSections, expected)) failures.push("package template must contain sections 1 through 31");
    if (!sameSequence(packageSections, expected)) failures.push("MARZI-020 must contain sections 1 through 31");
    if (!package020.startsWith("# MARZI-020 — Canonical Product and Architecture Contracts")) {
      failures.push("MARZI-020 canonical title mismatch");
    }
    return { templateSections: templateSections.length, packageSections: packageSections.length };
  });

  check("product-bible-consistency", () => {
    const expected = expectedSequence(1, 25);
    const sections = numberedSections(bible);
    if (!sameSequence(sections, expected)) failures.push("Product Bible must contain sections 1 through 25");
    for (const marker of [
      "PRODUCT OWNER DECISION REQUIRED",
      "ASSET REQUIRED",
      "TECHNICAL DISCOVERY REQUIRED",
      "COMMERCIAL DECISION REQUIRED",
      "LEGAL/PRIVACY REVIEW REQUIRED"
    ]) {
      if (!bible.includes(marker)) failures.push("Product Bible missing unresolved marker: " + marker);
    }
    if (!bible.includes("0, 150, 400, 800, 1500, 2600")) {
      failures.push("Product Bible missing frozen six-stage thresholds");
    }
    if (/\bMarzy\b/i.test(bible)) failures.push("Product Bible contains non-canonical Marzy spelling");
    return { sections: sections.length };
  });

  check("decision-register-consistency", () => {
    const detailed = Array.from(
      register.matchAll(/^### MARZI-D([0-9]{3}) —/gm),
      (match) => Number(match[1])
    );
    const indexed = Array.from(
      register.matchAll(/^[|] MARZI-D([0-9]{3}) [|]/gm),
      (match) => Number(match[1])
    );
    const expected = expectedSequence(1, 25);
    if (!sameSequence(detailed, expected)) failures.push("Decision Register details must be MARZI-D001 through D025");
    if (!sameSequence(indexed, expected)) failures.push("Decision Register index must be MARZI-D001 through D025");
    const requiredFields = [
      "Question",
      "Options",
      "Recommended option",
      "Rationale",
      "Product impact",
      "Technical impact",
      "Economic impact",
      "Accessibility impact",
      "Localization impact",
      "Decision owner",
      "Deadline",
      "Packages blocked"
    ];
    for (let number = 1; number <= 25; number++) {
      const id = String(number).padStart(3, "0");
      const start = register.indexOf("### MARZI-D" + id + " —");
      const end = number < 25
        ? register.indexOf("### MARZI-D" + String(number + 1).padStart(3, "0") + " —", start)
        : register.indexOf("## Approval record template", start);
      const section = register.slice(start, end);
      for (const field of requiredFields) {
        if (!section.includes("| " + field + " |")) {
          failures.push("MARZI-D" + id + " missing field: " + field);
        }
      }
    }
    const openCount = (register.match(/[|] OPEN [|]/g) || []).length;
    if (openCount !== 25) failures.push("Decision Register must have exactly 25 OPEN index records");
    return { indexed: indexed.length, detailed: detailed.length, open: openCount };
  });

  check("governance-consistency", () => {
    for (const role of ["### Product Owner", "### Codex", "### Claude Code"]) {
      if (!governance.includes(role)) failures.push("governance missing role: " + role.slice(4));
    }
    for (const status of [
      "DISCOVERY",
      "BLOCKED",
      "READY FOR IMPLEMENTATION",
      "IMPLEMENTING",
      "READY FOR REVIEW",
      "CHANGES REQUIRED",
      "READY FOR STAGING",
      "STAGING VALIDATED",
      "READY FOR MERGE",
      "MERGED",
      "RELEASED"
    ]) {
      if (!governance.includes("### " + status)) failures.push("governance missing status: " + status);
    }
    if (!governance.includes("## 3. Source-of-truth hierarchy")) failures.push("governance missing source-of-truth hierarchy");
    if (!governance.includes("## 5. Three independent readiness tracks")) failures.push("governance missing readiness tracks");
    return { requiredStatuses: 11 };
  });

  check("execution-policy-consistency", () => {
    if (!agents.includes(".ai/EXECUTION_POLICY.md")) failures.push("AGENTS.md does not reference execution policy");
    if (!policy.includes("Operations that always require explicit approval")) {
      failures.push("execution policy missing explicit-approval section");
    }
    for (const wrapper of WRAPPERS) {
      if (!policy.includes(wrapper)) failures.push("execution policy does not name wrapper: " + wrapper);
    }
    return { wrapperReferences: WRAPPERS.length };
  });

  check("workflow-wrapper-files", () => {
    for (const relative of WRAPPERS) {
      try {
        const absolute = resolveRepositoryFile(root, relative);
        try {
          fs.accessSync(absolute, fs.constants.X_OK);
        } catch {
          failures.push("wrapper is not executable: " + relative);
        }
      } catch (error) {
        failures.push(error.message);
      }
    }
    try {
      resolveRepositoryFile(root, ".ai/bin/lib.cjs");
    } catch (error) {
      failures.push(error.message);
    }
    const workflowSources = WRAPPERS.concat(".ai/bin/lib.cjs")
      .flatMap((relative) => {
        try {
          return [fs.readFileSync(resolveRepositoryFile(root, relative), "utf8")];
        } catch {
          return [];
        }
      });
    const unsafeShellPattern = new RegExp("shell\\s*:\\s*" + "true", "u");
    for (const source of workflowSources) {
      if (unsafeShellPattern.test(source)) failures.push("wrapper enables shell execution");
      if (/\beval\s*\(/.test(source)) failures.push("wrapper uses eval");
    }
    return { wrappers: WRAPPERS.length };
  });

  check("markdown-structure", () => {
    const backtickFence = String.fromCharCode(96).repeat(3);
    for (const pair of sources.entries()) {
      const relative = pair[0];
      const source = pair[1];
      if (!source.startsWith("# ")) failures.push(relative + ": missing level-one title");
      if (countFence(source, "~~~") % 2 !== 0) failures.push(relative + ": unbalanced tilde fence");
      if (countFence(source, backtickFence) % 2 !== 0) failures.push(relative + ": unbalanced backtick fence");
      if (/[ \t]+$/m.test(source)) failures.push(relative + ": trailing whitespace");
      if (!source.endsWith("\n")) failures.push(relative + ": missing final newline");
    }
    return { files: sources.size };
  });

  check("broken-internal-references", () => {
    for (const pair of sources.entries()) {
      failures.push(...internalLinks(root, pair[0], pair[1]));
    }
    return { files: sources.size };
  });

  check("conflict-markers", () => {
    for (const pair of sources.entries()) {
      if (/^(?:<<<<<<<|=======|>>>>>>>)/m.test(pair[1])) {
        failures.push(pair[0] + ": conflict marker");
      }
    }
    return { files: sources.size };
  });

  check("git-diff-check", () => {
    const unstaged = git(root, ["diff", "--check"], { allowedExitCodes: [0, 2] });
    const staged = git(root, ["diff", "--cached", "--check"], { allowedExitCodes: [0, 2] });
    if (unstaged.status !== 0) failures.push("git diff --check failed: " + unstaged.stdout.trim());
    if (staged.status !== 0) failures.push("git diff --cached --check failed: " + staged.stdout.trim());
    return { unstagedStatus: unstaged.status, stagedStatus: staged.status };
  });

  const status = failures.length === 0 ? "PASS" : "FAIL";
  emitJson({
    status,
    tool: TOOL,
    schemaVersion: 1,
    checksExecuted: checks,
    failures,
    warnings,
    filesInspected: Array.from(sources.keys()).sort(),
    packageCount: packageIds.length
  });
  if (failures.length) process.exitCode = EXIT.VALIDATION;
});
